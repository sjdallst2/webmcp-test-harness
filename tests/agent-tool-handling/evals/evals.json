  {
    "name": "[WW-21-values] Structured and meaningful falsy results",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Call get_widget_result_sample for these shapes in order: structured, number, false, null, empty. Explain each result. Do not treat false, null or an empty string as a tool failure."
      }
    ],
    "expectedCall": [
      {
        "functionName": "get_widget_result_sample",
        "arguments": { "shape": "structured" },
        "result": { "ok": true, "widgets": [{ "id": "gear-widget", "priceCents": 350 }] }
      },
      { "functionName": "get_widget_result_sample", "arguments": { "shape": "number" }, "result": 350 },
      { "functionName": "get_widget_result_sample", "arguments": { "shape": "false" }, "result": false },
      { "functionName": "get_widget_result_sample", "arguments": { "shape": "null" }, "result": null },
      { "functionName": "get_widget_result_sample", "arguments": { "shape": "empty" }, "result": "" }
    ]
  }
]
